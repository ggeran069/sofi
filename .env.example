# Database
# Local Docker: postgres://postgres:postgres@localhost:5432/sofia
# Neon (production): postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# NOTE: any *.neon.tech URL automatically uses the Neon HTTP driver, which is
# required on Cloudflare Workers (raw TCP is not supported there).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sofia

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-char-string
# Local dev (without Docker proxy): http://localhost:3000
# Local dev (with Docker/Caddy): https://localhost:3443
# Production (Cloudflare Workers): https://sofi.<your-subdomain>.workers.dev
AUTH_URL=http://localhost:3000

# Vercel Blob (still works on Cloudflare — it is HTTP-based, just needs the token)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx_placeholder

# Optional: Resend for contact form emails
# RESEND_API_KEY=re_xxx

# === Cloudflare deployment ===
# Production secrets are NOT read from .env — set them with:
#   npx wrangler secret put DATABASE_URL
#   npx wrangler secret put AUTH_SECRET
#   npx wrangler secret put AUTH_URL
#   npx wrangler secret put BLOB_READ_WRITE_TOKEN
#
# For local `npm run preview` (wrangler dev), copy .env to .dev.vars
# (gitignored): cp .env .dev.vars
