{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sofi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sofi-db",
      "database_id": "318f4542-ef62-4ad4-b2b5-d2564d7c6ed3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sofi-media"
    }
  ]
}
