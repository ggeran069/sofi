{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sofi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sofi-db",
      "database_id": "7cfaf8ed-f495-46e5-94c7-9ff362d9d450"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "23a839f527eb4f05874d1d4cc1d3e863"
    }
  ]
}
